@using MudBlazor
@using Smbc.Risk.ReportingEngine.WebUI.Features.Themes.Store
@inherits LayoutComponentBase

@inject IState<AppState> AppState 
@inject IDispatcher Dispatcher 

@* Required *@
<MudThemeProvider IsDarkMode="@AppState.Value.IsDarkMode" Theme="AppTheme.CustomTheme" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider FullWidth="true"
                   MaxWidth="MaxWidth.Large"
                   CloseButton="true"
                   BackdropClick="false"
                   NoHeader="false"
                   Position="DialogPosition.Center"
                   CloseOnEscapeKey="true"
                    />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleSidebar" />

        <MudText Typo="Typo.h6"><MudButton Variant="Variant.Text" Color="Color.Inherit">Risk Reporting</MudButton></MudText>
        
        <MudSpacer />

        @* Theme Toggle Button *@
        <MudTooltip Text="@(AppState.Value.IsDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">   
            <MudIconButton Icon="@(AppState.Value.IsDarkMode ? Icons.Material.Filled.WbSunny : Icons.Material.Filled.NightsStay)"
                           Color="Color.Inherit"
                           OnClick="ToggleTheme" />
        </MudTooltip>

        <MudBadge Content="@AppState.Value.UnreadNotificationCount"
                  Color="Color.Error"
                  Overlap="true"
                  Bordered="true"
                  Visible="@(AppState.Value.UnreadNotificationCount > 0)">

            <MudTooltip Text="View Notifications">
                <MudIconButton Icon="@Icons.Material.Outlined.Notifications"
                            Size="Size.Medium"
                            Color="Color.Inherit"
                            Ripple="true"
                            Variant="Variant.Outlined" />
            </MudTooltip>

        </MudBadge>
@* 
        <MudBadge Color="Color.Success" Overlap="true" Bordered="true">
            <MudAvatar>
                <MudImage Src="images/profile.jpg" />
            </MudAvatar>
        </MudBadge> *@

    </MudAppBar>
    <MudDrawer Open="@AppState.Value.IsSidebarOpen" 
               OpenChanged="OnOpenChanged" 
               ClipMode="DrawerClipMode.Always" 
               Elevation="6" 
               Variant="DrawerVariant.Responsive" 
               OpenMiniOnHover="true">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pt-5">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isNotificationOpen;
    private bool _isProfileOpen;

    private void ToggleSidebar() => Dispatcher.Dispatch(new ToggleSidebarAction());
    private void ToggleTheme() => Dispatcher.Dispatch(new ToggleThemeAction());
    private void ToggleNotifications()
    {
        _isNotificationOpen = !_isNotificationOpen;
        if (_isNotificationOpen) _isProfileOpen = false; // Close profile if notification opens
    }

    private void OnOpenChanged(bool isOpen)
    {
        if (isOpen != AppState.Value.IsSidebarOpen)
        {
            Dispatcher.Dispatch(new ToggleSidebarAction());
        }
    }
}

