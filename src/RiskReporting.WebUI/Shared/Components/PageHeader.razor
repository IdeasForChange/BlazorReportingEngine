<PageTitle>@PageTitle</PageTitle>

<div class="page-header mb-6">
    <MudText Typo="Typo.h3"
             Class="page-title font-weight-bold"
             Style="text-shadow: 1px 2px 4px rgba(0, 0, 0, 0.15); letter-spacing: -0.02em;">
        @PageTitle
    </MudText>

    @if (!string.IsNullOrWhiteSpace(PageSubTitle))
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-1">
            <MudIcon Icon="@Icons.Material.Outlined.Info"
                     Size="Size.Small"
                     Color="Color.Info"
                     Class="mr-1" />
            <MudText Typo="Typo.subtitle1"
                     Color="Color.Primary"
                     Class="page-subtitle">
                @PageSubTitle
            </MudText>
        </MudStack>
    }
</div>

@code {
    [Parameter]
    public string? PageTitle { get; set; }

    [Parameter]
    public string? PageSubTitle { get; set; }
}