@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using BlazorMonaco.Editor
@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects
@using Smbc.Risk.ReportingEngine.Domain.Shared.Enums
@using Smbc.Risk.ReportingEngine.WebUI.Features.DatabaseConnections.Store

@inject IConfiguration Configuration
@inject IDispatcher Dispatcher
@inject IState<DatabaseConnectionState> ConnectionState

<MudForm @ref="_form" @bind-IsValid="_isValid">

    @* Action Bar Header *@
    <MudPaper Class="pa-3 px-2 ma-2 rounded-lg d-flex justify-space-between align-center" 
                Outlined="true">

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIconButton Icon="@Icons.Material.Outlined.Assessment" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Edit Report Template</MudText>
                <MudText Typo="Typo.caption" Color="Color.Primary">
                    Modify report templates by adding parameters and completing the SQL Metrics.
                </MudText>
            </MudStack>
        </MudStack>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="OnSave"
                   Class="rounded-pill">
            Save Changes
        </MudButton>
    </MudPaper>

    @* Inner Pill-Style Sub Tabs *@
    <MudTabs Elevation="1"
             ApplyEffectsToContainer="true"
             Rounded="true"
             Border="true"
             Outlined="true"
             Color="Color.Warning"
             TabPanelsClass="pa-2 ma-2">

        @* SUB-TAB 1: General Info *@
        <MudTabPanel Text="Master Settings" Icon="@Icons.Material.Outlined.Settings">
           
              <MudPaper Elevation="0" Class="rounded">
                    <MudStack Spacing="2">

                        <MudGrid Spacing="1" Class="pt-4">
                            <MudItem xs="12" md="8">
                                <MudTextField T="string"
                                              @bind-Value="Model.Name"
                                              Label="Report Master Name"
                                              Placeholder="e.g. Risk VaR Report"
                                              Required="true"
                                              RequiredError="Report master name is required."
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Description"
                                              AdornmentColor="Color.Primary" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudPaper Class="d-flex justify-space-between align-center border-dashed">
                                    <MudStack Spacing="0" Class="pa-1">
                                        <MudText Typo="Typo.caption" Color="Color.Primary">Template Status</MudText>
                                        <MudText Typo="Typo.body2" Color="@(Model.IsActive ? Color.Success : Color.Error)">
                                            @(Model.IsActive ? "Active" : "Inactive")
                                        </MudText>
                                    </MudStack>
                                    <MudSwitch T="bool"
                                               @bind-Value="Model.IsActive"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               AriaLabel="Toggle template status" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField T="string"
                                              @bind-Value="Model.Description"
                                              Label="Description"
                                              Placeholder="Optional operational notes..."
                                              Lines="2"
                                              MaxLength="1000"
                                              Counter="1000"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

                 <MudPaper Elevation="0" Class="rounded">
                    <MudStack Spacing="2">

                        <MudGrid Spacing="1">    
                            
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              @bind-Value="Model.ReportDirectory"
                                              Label="Report Directory"
                                              Placeholder="C:\Reports\Finance"
                                              Required="true"
                                              RequiredError="Report directory path is required."
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Folder"
                                              AdornmentColor="Color.Secondary" />
                            </MudItem>

                            <MudItem xs="12" md="8">
                                <MudTextField T="string"
                                              @bind-Value="Model.ReportNamePattern"
                                              Label="Report Name Pattern"
                                              Placeholder="Risk_VaR_Report_{YYYY}_{MM}_{DD}.xlsx"
                                              Required="true"
                                              RequiredError="Report name pattern is required."
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.DataObject"
                                              AdornmentColor="Color.Secondary" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <!-- Tokens -->
                                <MudStack Spacing="0" Class="pa-0 ml-5">
                                    <MudText Typo="Typo.caption" Color="Color.Primary">Insert Report Name Token</MudText>
                                    <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection">
                                        <MudChip Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="@(() => AddToken("{YYYY}"))">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-1" /> Year
                                        </MudChip>
                                        <MudChip Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="@(() => AddToken("{MM}"))">Month</MudChip>
                                        <MudChip Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="@(() => AddToken("{DD}"))">Day</MudChip>
                                        <MudChip Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="@(() => AddToken("{Quarter}"))">Quarter</MudChip>
                                    </MudChipSet> 
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12">
                                <!-- Live Preview -->
                                @if (!string.IsNullOrWhiteSpace(Model.ReportNamePattern))
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Visibility">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Generated filename preview</MudText>
                                            <MudText Typo="Typo.body2"><b>@GenerateSampleFilename(Model.ReportNamePattern)</b></MudText>
                                        </MudStack>
                                    </MudAlert>
                                }
                            </MudItem>

                        </MudGrid>
                    </MudStack>
                </MudPaper>

        </MudTabPanel>

        @* SUB-TAB 2: Parameters Manager *@
        <MudTabPanel Text="Parameters" Icon="@Icons.Material.Outlined.Tune" BadgeData="@Model.ReportParameters.Count" BadgeColor="Color.Primary">
            
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 mt-2 pt-4">
                <div>
                    <MudText Typo="Typo.h6">&nbsp;</MudText>
                </div>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" OnClick="AddParameter" Class="rounded-pill">
                    Add Parameter
                </MudButton>
            </MudStack>

            @if (!Model.ReportParameters.Any())
            {
                <MudPaper Class="pa-8 text-center border-dashed rounded-lg" Elevation="0">
                    <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                    <MudText Typo="Typo.body1" Color="Color.Secondary">No parameters added yet.</MudText>
                </MudPaper>
            }
            else
            {
                <MudTable Items="@Model.ReportParameters" Hover="true" Elevation="0" Outlined="true" Class="rounded-lg">
                    <HeaderContent>
                        <MudTh>Parameter Name</MudTh>
                        <MudTh>Data Type</MudTh>
                        <MudTh>Required</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><MudTextField @bind-Value="context.Name" Required="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudTd>
                        <MudTd>
                            <MudSelect T="ParameterType" @bind-Value="context.ParameterType" Margin="Margin.Dense" Variant="Variant.Outlined">
                                @foreach (ParameterType type in Enum.GetValues<ParameterType>())
                                {
                                    <MudSelectItem Value="@type">@GetEnumDisplayName(type)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd><MudCheckBox @bind-Value="context.IsRequired" Color="Color.Primary" Dense="true" /></MudTd>
                        <MudTd Style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => Model.ReportParameters.Remove(context)" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        @* SUB-TAB 3: Templates & Formatted SQL Query Metrics *@
        <MudTabPanel Text="Template & Metrics" Icon="@Icons.Material.Outlined.Code" BadgeData="@_latestTemplate?.ReportMetrics.Count" BadgeColor="Color.Secondary">
            <MudExpansionPanels MultiExpansion="false">
                <MudExpansionPanel Text="Upload a new Template" Class="mb-2">
                    <MudItem xs="12">
                        <MudFileUpload T="IBrowserFile"
                                       OnFilesChanged="UploadFile"
                                       Class="mt-4"
                                       Accept=".xlsx, .xlst, .xls"
                                       Disabled="@string.IsNullOrWhiteSpace(Model.Name)"
                                       Required="true">
                            <CustomContent>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Secondary"
                                           OnClick="@context.OpenFilePickerAsync"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">
                                    Upload Excel Template File
                                </MudButton>
                            </CustomContent>
                            <SelectedTemplate>
                                @if (context != null && _selectedFile != null)
                                {
                                    <MudText Color="Color.Secondary"><code>Selected File: <strong>@_selectedFile.Name</strong> - @_selectedFile.Size bytes</code> </MudText>
                                }
                            </SelectedTemplate>
                        </MudFileUpload>
                    </MudItem>

                    <MudItem xs="12">
                        <MudRadioGroup T="SpreadsheetQueryType"
                                       @bind-Value="Model.QueryType">
                            <MudRadio Value="SpreadsheetQueryType.QueryInCell" Color="Color.Primary">Query In Cell</MudRadio>
                            <MudRadio Value="SpreadsheetQueryType.QueryInDefinedName" Color="Color.Primary">Query In Defined Name</MudRadio>
                        </MudRadioGroup>
                    </MudItem>

                    @if (Model.QueryType == SpreadsheetQueryType.QueryInDefinedName)
                    {
                        <MudItem xs="12">
                            <MudTextField T="string"
                                          @bind-Value="Model.DefinedNameFilters"
                                          Label="Template Defined Filter Patterns"
                                          Placeholder="@Model.DefinedNameFilters"
                                          RequiredError="Defined Name Filters"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Filter"
                                          AdornmentColor="Color.Secondary" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Info">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Defined Name Query Info</MudText>
                                    <MudText Typo="Typo.body2">
                                        When using the "Query In Defined Name" option, the system will look for defined names in the Excel template that match the specified filter patterns.
                                        Ensure that your template contains defined names that correspond to your data queries.
                                    </MudText>
                                </MudStack>
                            </MudAlert>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" sm="10">
                            <MudSelect T="long?" @bind-Value="_latestTemplate.DatabaseConnectionId" Label="Database Connection" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var connection in ConnectionState.Value.Connections)
                                {
                                    <MudSelectItem Value="@connection.Id">@($"[{connection.Environment}] [{connection.DatabaseType}] {connection.ConnectionName}")</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Info">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Database Connection</MudText>
                                    <MudText Typo="Typo.body2">
                                        When using the "Query In Cell" option, the system will look for SQL Queries in Cell in the Excel template.
                                        Ensure that your template's contains valid SQL that correspond to your data queries.
                                    </MudText>
                                </MudStack>
                            </MudAlert>
                        </MudItem>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>

            @if (Model.ReportTemplates.Count > 0 && Model.ReportTemplates.Any())
            {
                @if (_latestTemplate != null)
                {
                    <MudCard Class="mb-2 rounded-lg" Outlined="true" Elevation="0">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:200;">
                                    <strong>Name (Original):</strong> @(_latestTemplate.OriginalFileName) <br />
                                    <strong>Name (Modified):</strong> @(_latestTemplate.UploadedFileName) <br />
                                    <strong>Version:</strong> @_latestTemplate.TemplateVersion <br />
                                    <strong>Filters:</strong> @_latestTemplate.QueryType <br />
                                    @if (_latestTemplate.QueryType == SpreadsheetQueryType.QueryInCell)
                                    {
                                        <strong>Filters:</strong> @_latestTemplate.DefinedNameFilters
                                    }
                                </MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                               Color="Color.Error" Size="Size.Large" 
                                               Variant="Variant.Filled" 
                                               OnClick="() => Model.ReportTemplates.Remove(_latestTemplate)" />
                            </CardHeaderActions>
                        </MudCardHeader>

                        @if (_latestTemplate.ReportMetrics.Count > 0)
                        {
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Color="Color.Primary">Query Metrics</MudText>
                                <MudExpansionPanels MultiExpansion="false">

                                    @foreach (var metric in _latestTemplate.ReportMetrics)
                                    {
                                        <MudExpansionPanel Text="@metric.NamedRange">
                                            <MudPaper Class="pa-3 mb-3 rounded-lg" Outlined="true" Elevation="0" Style="border-left: 4px solid var(--mud-palette-primary) !important;">
                                                <MudGrid Class="mb-2">
                                                    <MudItem xs="12" sm="10">
                                                        <MudSelect T="long?" @bind-Value="metric.DatabaseConnectionId" Label="Target DB" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                            @foreach (var connection in ConnectionState.Value.Connections)
                                                            {
                                                                <MudSelectItem Value="@connection.Id">@($"[{connection.Environment}] [{connection.DatabaseType}] {connection.ConnectionName}")</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudItem>
                                                    <MudItem xs="12" sm="2">
                                                        <MudNumericField @bind-Value="metric.MaxRows" Label="Max Rows" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Min="1"/>
                                                    </MudItem>
                                                    <MudItem xs="12">
                                                        <div class="sql-editor-wrapper">
                                                            <StandaloneCodeEditor @ref="_editorMap[metric.NamedRange]"
                                                                                  ConstructionOptions="(e) => GetMonacoOptions(e, metric.SqlQuery)"
                                                                                  OnDidChangeModelContent="() => UpdateSqlQuery(metric)"/>
                                                        </div>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudExpansionPanel>
                                    }
                                </MudExpansionPanels>
                            </MudCardContent>
                        }
                    </MudCard>
                }
            }
        
        </MudTabPanel>
    
    </MudTabs>
</MudForm>

<style>
    .sql-editor-wrapper {
        height: 220px !important;
        width: 100%;
        border-top: 1px solid var(--mud-palette-lines-default);
    }

        .sql-editor-wrapper .monaco-editor-container {
            height: 100% !important;
            width: 100%;
        }
</style>

@code {
    [Parameter] public string TabId { get; set; } = string.Empty;
    [Parameter] public ReportMasterDto Model { get; set; } = new();
    [Parameter] public EventCallback OnSave { get; set; }

    private MudForm _form = default!;
    private bool _isValid;
    private Dictionary<string, StandaloneCodeEditor> _editorMap = new();
    private IBrowserFile? _selectedFile;
    private string? _definedNameFilters;
    private ReportTemplateDto? _latestTemplate => Model.ReportTemplates.MaxBy(p => p.TemplateVersion);

    protected override void OnInitialized()
    {
        _definedNameFilters = Configuration.GetValue<string>("DEFINED_NAME_FILTERS")!;
        Dispatcher.Dispatch(new FetchDatabaseConnectionAction());
        base.OnInitialized();
    }

    private class MetricPreviewState
    {
        public bool IsLoading { get; set; }
        public Dictionary<string, string> ParamValues { get; set; } = new();
    }

    private void AddParameter() => Model.ReportParameters.Add(new ReportParameterDto());

    private StandaloneEditorConstructionOptions GetMonacoOptions(StandaloneCodeEditor editor, string initialSql)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "sql",
            Value = initialSql,
            Theme = "vs-dark",
            
            Minimap = new EditorMinimapOptions { Enabled = false },
            ScrollBeyondLastLine = false
        };
    }

    private async Task UpdateSqlQuery(ReportMetricDto metric)
    {
        if (_editorMap.TryGetValue(metric.NamedRange, out var editor))
        {
            metric.SqlQuery = await editor.GetValue();
        }
    }

    private void AddToken(string token)
    {
        Model.ReportNamePattern ??= string.Empty;
        Model.ReportNamePattern += token;
    }

    private string GenerateSampleFilename(string? pattern)
    {
        if (string.IsNullOrWhiteSpace(pattern))
            return string.Empty;

        var now = DateTime.UtcNow;

        return pattern
            .Replace("{YYYY}", now.ToString("yyyy"))
            .Replace("{MM}", now.ToString("MM"))
            .Replace("{DD}", now.ToString("dd"))
            .Replace("{Quarter}", $"Q{(now.Month - 1) / 3 + 1}");
    }

    private string GetEnumDisplayName<TEnum>(TEnum value) where TEnum : Enum
    {
        var field = value.GetType().GetField(value.ToString());
        var attribute = field?.GetCustomAttribute<DisplayAttribute>();
        return attribute?.Name ?? value.ToString();
    }

    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        using var memoryStream = new MemoryStream();
        await _selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);

        var temporaryTemplateId = -1; // Temporary ID for new template
        var template = Model.ReportTemplates.Where(p => p.Id == temporaryTemplateId).FirstOrDefault();

        if(template != null)
        {
            Model.ReportTemplates.Remove(template);
        }

        template = new ReportTemplateDto
        {
            Id = temporaryTemplateId,
            OriginalFileName = _selectedFile.Name,
            UploadedFileName = _selectedFile.Name,
            DefinedNameFilters = _definedNameFilters,
            FileBytes = memoryStream.ToArray(),
            FileName = _selectedFile.Name,
        };

        Model.ReportTemplates.Add(template);
    }
}