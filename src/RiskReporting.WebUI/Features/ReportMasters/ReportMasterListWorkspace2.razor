@page "/report-workspace2"

@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects
@using Smbc.Risk.ReportingEngine.WebUI.Features.ReportMasters.Store

@inherits FluxorComponent
@inject IState<ReportMasterState> State
@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-6">
    
    @* Page Header Banner *@
    <MudPaper Class="pa-4 mb-4 rounded-lg d-flex justify-space-between align-center" Elevation="1" Style="background: linear-gradient(135deg, var(--mud-palette-surface) 0%, var(--mud-palette-background-grey) 100%);">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--mud-palette-primary);">
                <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="mr-2" Style="vertical-align: middle;" />
                Report Master Studio
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Manage report definitions, parameters, and live SQL metrics queries in a unified workspace.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add" 
                   OnClick="OpenBlankReport" 
                   Class="rounded-pill px-4">
            New Report
        </MudButton>
    </MudPaper>

    @* Styled Workspace Multi-Tabs *@
    <MudPaper Elevation="2" Class="rounded-lg overflow-hidden">
        <MudDynamicTabs @bind-ActivePanelIndex="_activeTabIndex" 
                        AddTab="OpenBlankReport" 
                        CloseTab="CloseTab" 
                        AddIconToolTip="Create New Report" 
                        ApplyEffectsToPanels="true"
                        PanelClass="pa-5" 
                        Elevation="0"
                        HeaderPosition="TabHeaderPosition.After">

            @* Main Master Grid Tab *@
            <MudTabPanel Text="All Reports" Icon="@Icons.Material.Outlined.Dashboard" CanClose="false">
                <MudTable Items="@State.Value.Reports" 
                          Loading="@State.Value.IsLoading" 
                          Hover="true" 
                          Elevation="0"
                          Outlined="false"
                          Class="rounded-md">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Report Name</MudTh>
                        <MudTh>File Pattern</MudTh>
                        <MudTh>Parameters</MudTh>
                        <MudTh>Templates</MudTh>
                        <MudTh Style="text-align:right">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTdDataLabel DataLabel="ID">
                            <MudText Typo="Typo.caption" Class="text-muted">#@context.Id</MudText>
                        </MudTdDataLabel>
                        <MudTdDataLabel DataLabel="Name">
                            <MudLink OnClick="() => OpenReportInTab(context)" Style="font-weight: 600;" Color="Color.Primary">
                                @context.Name
                            </MudLink>
                            @if (!string.IsNullOrEmpty(context.Description))
                            {
                                <MudText Typo="Typo.caption" Display="Display.Block" Color="Color.Secondary">@context.Description</MudText>
                            }
                        </MudTdDataLabel>
                        <MudTdDataLabel DataLabel="Pattern">
                            <code class="px-2 py-1 rounded border" style="background: var(--mud-palette-background-grey); font-size: 0.8rem;">
                                @context.ReportNamePattern
                            </code>
                        </MudTdDataLabel>
                        <MudTdDataLabel DataLabel="Parameters">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Outlined.Tune">
                                @context.Parameters.Count Params
                            </MudChip>
                        </MudTdDataLabel>
                        <MudTdDataLabel DataLabel="Templates">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Icon="@Icons.Material.Outlined.Description">
                                @context.Templates.Count Templates
                            </MudChip>
                        </MudTdDataLabel>
                        <MudTdDataLabel DataLabel="Actions" Style="text-align:right">
                            <MudButton Variant="Variant.Text" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       EndIcon="@Icons.Material.Filled.OpenInNew" 
                                       OnClick="() => OpenReportInTab(context)">
                                Open Studio
                            </MudButton>
                        </MudTdDataLabel>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            @* Individual Report Tabs *@
            @foreach (var tab in _openTabs)
            {
                <MudTabPanel Text="@(string.IsNullOrEmpty(tab.Model.Name) ? "Unsaved Report" : tab.Model.Name)" 
                             Icon="@Icons.Material.Outlined.Edit" 
                             ID="@tab.TabId">
                    <ReportMasterDetailView2 Model="tab.Model" OnSave="() => SaveReport(tab.Model)" />
                </MudTabPanel>
            }
        </MudDynamicTabs>
    </MudPaper>
</MudContainer>

@code {
    private int _activeTabIndex = 0;
    private List<ReportTabItem> _openTabs = new();

    public class ReportTabItem
    {
        public string TabId { get; set; } = Guid.NewGuid().ToString();
        public ReportMasterDto Model { get; set; } = new();
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new FetchReportMasterAction());
    }

    private void OpenReportInTab(ReportMasterDto dto)
    {
        var existingTab = _openTabs.FirstOrDefault(t => t.Model.Id == dto.Id);
        if (existingTab != null)
        {
            _activeTabIndex = _openTabs.IndexOf(existingTab) + 1;
            return;
        }

        var tabModel = new ReportMasterDto
        {
            Id = dto.Id,
            Name = dto.Name,
            Description = dto.Description,
            ReportNamePattern = dto.ReportNamePattern,
            ReportDirectory = dto.ReportDirectory,
            IsActive = dto.IsActive,
            Parameters = dto.Parameters.ToList(),
            Templates = dto.Templates.ToList()
        };

        _openTabs.Add(new ReportTabItem { Model = tabModel });
        _activeTabIndex = _openTabs.Count;
    }

    private void OpenBlankReport()
    {
        _openTabs.Add(new ReportTabItem { Model = new ReportMasterDto() });
        _activeTabIndex = _openTabs.Count;
    }

    private void CloseTab(MudTabPanel panel)
    {
        var tabToRemove = _openTabs.FirstOrDefault(t => t.TabId == (string)panel.ID);
        if (tabToRemove != null)
        {
            _openTabs.Remove(tabToRemove);
        }
    }

    private void SaveReport(ReportMasterDto dto)
    {
        //Dispatcher.Dispatch(new SaveReportMasterAction(dto));
        Snackbar.Add($"Report '{dto.Name}' saved successfully.", Severity.Success);
    }
}