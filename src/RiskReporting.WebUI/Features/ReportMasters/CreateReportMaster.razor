@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects

@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIconButton Icon="@Icons.Material.Outlined.Assessment" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Add Report Template</MudText>
                <MudText Typo="Typo.caption" Color="Color.Primary">
                    Configure the report details, report output and storage location.
                </MudText>
            </MudStack>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="0">
                <!-- Basic Information -->
                <MudPaper Elevation="0" Class="rounded">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Info" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Medium" />
                            <MudStack Spacing="0" Class="ml-1">
                                <MudText Typo="Typo.subtitle2">Basic Information</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Primary">Identify and describe this report template.</MudText>
                            </MudStack>
                        </MudStack>

                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="8">
                                <MudTextField T="string"
                                              @bind-Value="_model.Name"
                                              Label="Report Master Name"
                                              Placeholder="e.g. Risk VaR Report"
                                              Required="true"
                                              RequiredError="Report master name is required."
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Description"
                                              AdornmentColor="Color.Primary" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudPaper Class="d-flex justify-space-between align-center border-dashed">
                                    <MudStack Spacing="0" Class="pa-1">
                                        <MudText Typo="Typo.caption" Color="Color.Primary">Template Status</MudText>
                                        <MudText Typo="Typo.body2" Color="@(_model.IsActive ? Color.Success : Color.Error)">
                                            @(_model.IsActive ? "Active" : "Inactive")
                                        </MudText>
                                    </MudStack>
                                    <MudSwitch T="bool"
                                               @bind-Value="_model.IsActive"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               AriaLabel="Toggle template status" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField T="string"
                                              @bind-Value="_model.Description"
                                              Label="Description"
                                              Placeholder="Optional operational notes..."
                                              Lines="2"
                                              MaxLength="1000"
                                              Counter="1000"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

                <!-- Output Configuration Configuration -->
                <MudPaper Elevation="0" Class="rounded">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIconButton Icon="@Icons.Material.Outlined.FolderOpen" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Medium" />
                            <MudStack Spacing="0" Class="ml-1">
                                <MudText Typo="Typo.subtitle2">File Configuration</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Primary">Define how generated reports are named and stored.</MudText>
                            </MudStack>
                        </MudStack>

                        <MudGrid Spacing="1">
                            <MudItem xs="12">
                                <MudFileUpload T="IBrowserFile" 
                                    OnFilesChanged="UploadFile" 
                                    Class="mt-4"
                                    Accept=".xlsx, .xlst, .xls"
                                    Disabled="@string.IsNullOrWhiteSpace(_model.Name)"
                                    Required="true">
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                        @(selectedFile == null ? "Upload Excel Template File" : selectedFile.Name)
                                    </MudButton>
                                </MudFileUpload>
                            </MudItem>

                            <MudItem xs="12" md="8">
                                <MudTextField T="string"
                                              @bind-Value="_model.ReportNamePattern"
                                              Label="Report Name Pattern"
                                              Placeholder="Risk_VaR_Report_{YYYY}_{MM}_{DD}.xlsx"
                                              Required="true"
                                              RequiredError="Report name pattern is required."
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@Icons.Material.Filled.DataObject"
                                              AdornmentColor="Color.Secondary" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <!-- Tokens -->
                                <MudStack Spacing="0" Class="pa-0 ml-5">
                                    <MudText Typo="Typo.caption" Color="Color.Primary">Insert Report Name Token</MudText>
                                    <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection">
                                        <MudChip Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="@(() => AddToken("{YYYY}"))">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-1" /> Year
                                        </MudChip>
                                        <MudChip Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="@(() => AddToken("{MM}"))">Month</MudChip>
                                        <MudChip Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="@(() => AddToken("{DD}"))">Day</MudChip>
                                        <MudChip Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="@(() => AddToken("{Quarter}"))">Quarter</MudChip>
                                    </MudChipSet> 
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12">
                                <!-- Live Preview -->
                                @if (!string.IsNullOrWhiteSpace(_model.ReportNamePattern))
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Visibility">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Generated filename preview</MudText>
                                            <MudText Typo="Typo.body2"><b>@GenerateSampleFilename(_model.ReportNamePattern)</b></MudText>
                                        </MudStack>
                                    </MudAlert>
                                }
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              @bind-Value="_model.ReportDirectory"
                                              Label="Report Directory"
                                              Placeholder="C:\Reports\Finance"
                                              Required="true"
                                              RequiredError="Report directory path is required."
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Folder"
                                              AdornmentColor="Color.Secondary" />
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudPaper>

            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Style="width: 100%;" Class="px-6 pb-4 pt-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="Cancel" Disabled="_isSubmitting" StartIcon="@Icons.Material.Filled.Cancel">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="ResetForm" Disabled="_isSubmitting" StartIcon="@Icons.Material.Filled.LockReset">
                Reset
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="@(!_isValid || _isSubmitting)" StartIcon="@Icons.Material.Filled.Save">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>Create Template</span>
                }
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    private IBrowserFile? selectedFile;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSubmitting;
    private SaveReportMasterDto _model = new();

    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        using var memoryStream = new MemoryStream();
        await selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
        _model.FileBytes = memoryStream.ToArray();
        _model.FileName = selectedFile.Name;
    }

    private void AddToken(string token)
    {
        _model.ReportNamePattern ??= string.Empty;
        _model.ReportNamePattern += token;
    }

    private string GenerateSampleFilename(string? pattern)
    {
        if (string.IsNullOrWhiteSpace(pattern))
            return string.Empty;

        var now = DateTime.UtcNow;

        return pattern
            .Replace("{YYYY}", now.ToString("yyyy"))
            .Replace("{MM}", now.ToString("MM"))
            .Replace("{DD}", now.ToString("dd"))
            .Replace("{Quarter}", $"Q{(now.Month - 1) / 3 + 1}");
    }

    private void Cancel() => MudDialog.Cancel();
    private async Task ResetForm()
    {
        _model = new SaveReportMasterDto();
        _isValid = false;
        await _form.ResetAsync();
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();

        if (!_isValid)
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            MudDialog.Close(DialogResult.Ok(_model));
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}