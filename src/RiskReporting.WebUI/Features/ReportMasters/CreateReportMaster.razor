@using System.ComponentModel.DataAnnotations
@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects


@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar

<MudDialog Class="blur dialog-background"
           TitleClass="blur dialog-background-title"
           ContentClass="dialog-background-surface py-2"
           ActionsClass="dialog-background-surface">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AddChart" Class="mr-3" /> Add Report Template
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm>
            <MudGrid>

                <MudItem xs="12" md="8">
                    <MudTextField T="string"
                                  Label="Report Master Name"
                                  @bind-Value="_model.Name"
                                  Required="true"
                                  RequiredError="Report master name is required."
                                  HelperText="Unique identifier name for this report template profile."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudSwitch T="bool"
                               @bind-Value="_model.IsActive"
                               Color="Color.Success"
                               Label="@(_model.IsActive ? "Status: Active" : "Status: Inactive")" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Description & Operational Notes"
                                  @bind-Value="_model.Description"
                                  Lines="3"
                                  MaxLength="1000"
                                  Counter="1000"
                                 
                                  HelperText="Provide operational context regarding report intent, downstream consumers, or distribution requirements."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <!-- File Naming Pattern & Tokens Section -->
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1 font-weight-bold">
                        File Naming & Path Configuration
                    </MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Report Name Pattern"
                                  @bind-Value="_model.ReportNamePattern"
                                  Required="true"
                                  RequiredError="Report name pattern is required."
                                  HelperText="Define the generated file naming rule using placeholders (e.g., SalesReport_{YYYY}_{MM}_{DD}.xlsx)."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.DataObject"
                                  AdornmentColor="Color.Info" />
                </MudItem>

                <!-- Dynamic Pattern Placeholder Helpers -->
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="text-secondary d-block mb-1">
                        Click tokens below to append dynamic placeholders into the pattern:
                    </MudText>
                    <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection" OnChipClicked="@OnTokenChipClicked">
                        <MudChip Value="@("{YYYY}")" Text="{YYYY} (Year)" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" />
                        <MudChip Value="@("{MM}")" Text="{MM} (Month)" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" />
                        <MudChip Value="@("{DD}")" Text="{DD} (Day)" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" />
                        <MudChip Value="@("{Quarter}")" Text="{Quarter} (Q1-Q4)" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" />
                        <MudChip Value="@("{Dept}")" Text="{Dept} (Department)" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" />
                        <MudChip Value="@("{Seq}")" Text="{Seq} (Sequence)" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" />
                    </MudChipSet>
                </MudItem>

                <!-- Live Pattern Evaluation Preview -->
                @if (!string.IsNullOrWhiteSpace(_model.ReportNamePattern))
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Normal" Dense="true" Class="my-1">
                            <strong>Live Output Sample:</strong> <code>@GenerateSampleFilename(_model.ReportNamePattern)</code>
                        </MudAlert>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField T="string"
                                  Label="Report Directory Path"
                                  @bind-Value="_model.ReportDirectory"
                                  Required="true"
                                  RequiredError="Report directory path is required."
                                  HelperText="Target storage directory path (e.g., /exports/finance/monthly or C:\Storage\Reports)."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Folder"
                                  AdornmentColor="Color.Warning" />
                </MudItem>

                <!-- Description & Documentation -->
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1 font-weight-bold">
                        Documentation & Notes
                    </MudText>
                </MudItem>

                <!-- Advanced Operational Options -->
                <MudItem xs="12">
                    <MudExpansionPanels MultiExpansion="false">
                        <MudExpansionPanel Text="Advanced Folder & Execution Settings" HeaderIcon="@Icons.Material.Filled.Settings">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudCheckBox T="bool" @bind-Value="_createDirectoryIfMissing" Color="Color.Primary">
                                        Auto-create directory if missing
                                    </MudCheckBox>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudCheckBox T="bool" @bind-Value="_overwriteExisting" Color="Color.Warning">
                                        Allow file overwrite on duplicate pattern
                                    </MudCheckBox>
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetForm" Disabled="_isSubmitting">
            Reset
        </MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel" Disabled="_isSubmitting">
            Cancel
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(!_isValid || _isSubmitting)"
                   OnClick="Submit"
                   StartIcon="@Icons.Material.Filled.Save">
            @if (_isSubmitting)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Saving Record...</MudText>
            }
            else
            {
                <MudText>Create Report Master</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>
<style>
/*     .custom-class {
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(2px);
    } */

    .blur {
        backdrop-filter: blur(10px);
    }

/*     .dialog-background {
        background-color: transparent;
    } */

    .dialog-background-title {
        background: rgba(25, 135, 84, 0.80);
        /* background: rgba(var(--mud-palette-info-rgb), 0.5); */
        color: var(--mud-palette-white);
    }

    .dialog-background-surface {
        background: rgba(var(--mud-palette-surface-rgb), 0.75);
    }
</style>



@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSubmitting;
    private bool _createDirectoryIfMissing = true;
    private bool _overwriteExisting;
    private ReportMasterDto _model = new();

    private void OnTokenChipClicked(MudChip<string> chip)
    {
        if (chip?.Value != null)
        {
            _model.ReportNamePattern += chip.Value;
        }
    }

    private string GenerateSampleFilename(string pattern)
    {
        var now = DateTime.UtcNow;
        return pattern
            .Replace("{YYYY}", now.ToString("yyyy"))
            .Replace("{MM}", now.ToString("MM"))
            .Replace("{DD}", now.ToString("dd"))
            .Replace("{Quarter}", $"Q{(now.Month - 1) / 3 + 1}")
            .Replace("{Dept}", "FIN")
            .Replace("{Seq}", "001");
    }

    private void ResetForm()
    {
        _model = new ReportMasterDto();
        _createDirectoryIfMissing = true;
        _overwriteExisting = false;
        _form.ResetAsync();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _isSubmitting = true;

        // Dispatch action to Fluxor store to execute Web API request pipeline
        //Dispatcher.Dispatch(new CreateReportMasterAction(_model));

        // Signal completion back to the parent component page
        MudDialog.Close(DialogResult.Ok(_model));
    }
}