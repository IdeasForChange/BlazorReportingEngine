@page "/report-workspace1"


@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects
@using Smbc.Risk.ReportingEngine.WebUI.Features.ReportMasters.Store
@inherits FluxorComponent
@inject IState<ReportMasterState> State
@inject IDispatcher Dispatcher
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">Reporting Workspace</MudText>

<MudDynamicTabs @bind-ActivePanelIndex="_activeTabIndex" 
                AddTab="OpenBlankReport" 
                CloseTab="CloseTab" 
                AddIconToolTip="New Report" 
                PanelClass="pa-4" 
                Elevation="2">

    @* Tab 0: Master Search & Grid *@
    <MudTabPanel Text="All Reports" Icon="@Icons.Material.Filled.List" CanClose="false">
        <MudTable Items="@State.Value.Reports" Loading="@State.Value.IsLoading" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Pattern</MudTh>
                <MudTh>Parameters</MudTh>
                <MudTh>Templates</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Id</MudTd>
                <MudTd>
                    <MudLink OnClick="() => OpenReportInTab(context)">@context.Name</MudLink>
                </MudTd>
                <MudTd><code>@context.ReportNamePattern</code></MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Info">@context.Parameters.Count</MudChip></MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Secondary">@context.Templates.Count</MudChip></MudTd>
                <MudTd Style="text-align:right">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Color="Color.Primary" OnClick="() => OpenReportInTab(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>

    @* Dynamic Tabs for Individual Reports *@
    @foreach (var tab in _openTabs)
    {
        <MudTabPanel Text="@(string.IsNullOrEmpty(tab.Model.Name) ? "New Report" : tab.Model.Name)" ID="@tab.TabId">
            <ReportDetailView Model="tab.Model" OnSave="() => SaveReport(tab.Model)" />
        </MudTabPanel>
    }
</MudDynamicTabs>

@code {
    private int _activeTabIndex = 0;
    private List<ReportTabItem> _openTabs = new();

    public class ReportTabItem
    {
        public string TabId { get; set; } = Guid.NewGuid().ToString();
        public ReportMasterDto Model { get; set; } = new();
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new FetchReportMasterAction());
    }

    private void OpenReportInTab(ReportMasterDto dto)
    {
        var existingTab = _openTabs.FirstOrDefault(t => t.Model.Id == dto.Id);
        if (existingTab != null)
        {
            _activeTabIndex = _openTabs.IndexOf(existingTab) + 1;
            return;
        }

        var tabModel = new ReportMasterDto
        {
            Id = dto.Id,
            Name = dto.Name,
            Description = dto.Description,
            ReportNamePattern = dto.ReportNamePattern,
            ReportDirectory = dto.ReportDirectory,
            IsActive = dto.IsActive,
            Parameters = dto.Parameters.ToList(),
            Templates = dto.Templates.ToList()
        };

        _openTabs.Add(new ReportTabItem { Model = tabModel });
        _activeTabIndex = _openTabs.Count; // Focus newly opened tab
    }

    private void OpenBlankReport()
    {
        _openTabs.Add(new ReportTabItem { Model = new ReportMasterDto() });
        _activeTabIndex = _openTabs.Count;
    }

    private void CloseTab(MudTabPanel panel)
    {
        var tabToRemove = _openTabs.FirstOrDefault(t => t.TabId == (string)panel.ID);
        if (tabToRemove != null)
        {
            _openTabs.Remove(tabToRemove);
        }
    }

    private void SaveReport(SaveReportMasterDto dto)
    {
        Dispatcher.Dispatch(new SaveReportMasterAction(dto));
        Snackbar.Add($"Report '{dto.Name}' saved successfully.", Severity.Success);
    }
}