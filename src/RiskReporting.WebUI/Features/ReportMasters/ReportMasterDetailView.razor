@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using BlazorMonaco.Editor
@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects
@using Smbc.Risk.ReportingEngine.Domain.Shared.Enums

<MudForm @ref="_form" @bind-IsValid="_isValid">
    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">@(Model.Id == 0 ? "Create Report Configuration" : $"Editing: {Model.Name}")</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="OnSave">
            Save Changes
        </MudButton>
    </MudStack>

    <MudTabs Elevation="1" Rounded="true" PanelClass="pa-4">
        
        @* TAB 1: General Info *@
        <MudTabPanel Text="Master Settings" Icon="@Icons.Material.Filled.Settings">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Name" Label="Report Name" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.ReportNamePattern" Label="Report Name Pattern" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.ReportDirectory" Label="Output Directory Path" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Description" Label="Description" Lines="2" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch @bind-Value="Model.IsActive" Label="Active Status" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        @* TAB 2: Parameters Manager *@
        <MudTabPanel Text="Parameters" Icon="@Icons.Material.Filled.Tune">
            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6">Configured Report Parameters</MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Outlined" OnClick="AddParameter">Add Parameter</MudButton>
            </MudStack>

            <MudTable Items="@Model.Parameters" Hover="true" Elevation="1">
                <HeaderContent>
                    <MudTh>Parameter Name</MudTh>
                    <MudTh>Data Type</MudTh>
                    <MudTh>Required</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><MudTextField @bind-Value="context.Name" Required="true" Margin="Margin.Dense" /></MudTd>
                    <MudTd>
                        <MudSelect T="ParameterType" @bind-Value="context.ParameterType" Margin="Margin.Dense">
                            @foreach (ParameterType type in Enum.GetValues<ParameterType>())
                            {
                                <MudSelectItem Value="@type">@GetEnumDisplayName(type)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd><MudCheckBox @bind-Value="context.IsRequired" Color="Color.Secondary" /></MudTd>
                    <MudTd Style="text-align:right">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => Model.Parameters.Remove(context)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        @* TAB 3: Templates & Formatted SQL Query Metrics *@
        <MudTabPanel Text="Templates & SQL Metrics" Icon="@Icons.Material.Filled.Code">
            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-3">
                <MudText Typo="Typo.h6">Templates Configuration</MudText>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Outlined" OnClick="AddTemplate">Add Template</MudButton>
            </MudStack>

            @foreach (var template in Model.Templates)
            {
                <MudExpansionPanel Text="@($"Template: {(string.IsNullOrEmpty(template.TemplateFileName) ? "New Template File" : template.TemplateFileName)}")" Class="mb-3">
                    <MudGrid Class="mb-3">
                        <MudItem xs="12" sm="5">
                            <MudTextField @bind-Value="template.TemplateFileName" Label="File Name" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudTextField @bind-Value="template.TemplatePath" Label="Template Directory Path" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudNumericField @bind-Value="template.TemplateVersion" Label="Version" Required="true" Min="1" />
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-2" />
                    
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="my-2">
                        <MudText Typo="Typo.subtitle1">Template Metrics & Queries</MudText>
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Color="Color.Secondary" OnClick="() => AddMetric(template)">Add Query Metric</MudButton>
                    </MudStack>

                    @foreach (var metric in template.Metrics)
                    {
                        <MudPaper Class="pa-3 mb-3" Outlined="true" Elevation="0">
                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="metric.NamedRange" Label="Named Range" Required="true" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudSelect T="DatabaseType" @bind-Value="metric.DatabaseType" Label="Target DB">
                                        @foreach (DatabaseType dbType in Enum.GetValues<DatabaseType>())
                                        {
                                            <MudSelectItem Value="@dbType">@GetEnumDisplayName(dbType)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudNumericField @bind-Value="metric.MaxRows" Label="Max Rows" Clearable="true" Min="1" />
                                </MudItem>
                                <MudItem xs="12" sm="1" Class="d-flex justify-end">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => template.Metrics.Remove(metric)" />
                                </MudItem>
                                
                                @* Formatted SQL Code Editor *@
                                <MudItem xs="12">
                                    <MudText Typo="Typo.caption" Class="mb-1">SQL Query Editor</MudText>
                                    <div style="height: 200px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px;">
                                        <StandaloneCodeEditor @ref="_editorMap[metric]" 
                                                              ConstructionOptions="(e) => GetMonacoOptions(e, metric.SqlQuery)" 
                                                              OnDidChangeModelContent="() => UpdateSqlQuery(metric)" />
                                    </div>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                    <MudButton Color="Color.Error" Variant="Variant.Text" Size="Size.Small" OnClick="() => Model.Templates.Remove(template)">Delete Template</MudButton>
                </MudExpansionPanel>
            }
        </MudTabPanel>
    </MudTabs>
</MudForm>

@code {
    [Parameter] public ReportMasterDto Model { get; set; } = new();
    [Parameter] public EventCallback OnSave { get; set; }

    private MudForm _form = default!;
    private bool _isValid;
    private Dictionary<ReportMetricDto, StandaloneCodeEditor> _editorMap = new();

    private void AddParameter() => Model.Parameters.Add(new ReportParameterDto());
    private void AddTemplate() => Model.Templates.Add(new ReportTemplateDto());
    private void AddMetric(ReportTemplateDto template) => template.Metrics.Add(new ReportMetricDto());

    private StandaloneEditorConstructionOptions GetMonacoOptions(StandaloneCodeEditor editor, string initialSql)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = "sql",
            Value = initialSql,
            Theme = "vs-dark",
            Minimap = new EditorMinimapOptions { Enabled = false },
            ScrollBeyondLastLine = false
        };
    }

    private async Task UpdateSqlQuery(ReportMetricDto metric)
    {
        if (_editorMap.TryGetValue(metric, out var editor))
        {
            metric.SqlQuery = await editor.GetValue();
        }
    }

    private string GetEnumDisplayName<TEnum>(TEnum value) where TEnum : Enum
    {
        var field = value.GetType().GetField(value.ToString());
        var attribute = field?.GetCustomAttribute<DisplayAttribute>();
        return attribute?.Name ?? value.ToString();
    }
}