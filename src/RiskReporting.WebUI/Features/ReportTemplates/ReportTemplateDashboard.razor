@code {
    private MudDataGrid<ReportTemplateDto> _elementGrid = default!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new LoadReportsAction());
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateReportDialog>("Upload Excel & Setup Report");
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CreateReportTemplateRequest dto)
        {
            Dispatcher.Dispatch(new CreateTemplateAction(dto));
            Dispatcher.Dispatch(new LoadReportsAction());
        }
    }

    private async Task ManageReport(long id)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var parameters = new DialogParameters { ["ReportId"] = id };
        await DialogService.ShowAsync<EditReportDialog>("Report Configuration", parameters, options);
    }
}