@page "/report-templates"
@inherits FluxorComponent

@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects
@using Smbc.Risk.ReportingEngine.WebUI.Features.ReportTemplates.Store

@inject IState<ReportTemplateState> ReportTemplateState
@inject IDispatcher Dispatcher
@inject IDialogService DialogService


<MudDataGrid T="ReportTemplateDto" 
             Loading="@ReportTemplateState.Value.IsLoading"
             Items="@(ReportTemplateState.Value.Templates)"
             Class="px-4"
             Bordered="true"
             Dense="true"
             Hover="true"
             Elevation="25"
             FooterClass="d-flex"
             EditTrigger="DataGridEditTrigger.OnRowClick">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Report Templates</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog">Add New Report</MudButton>
    </ToolBarContent>
    <Columns>
        <HierarchyColumn T="ReportTemplateDto" />
        <PropertyColumn Property="x => x.Name" Title="Name" Editable="false" />
        <PropertyColumn Property="x => x.FileNamePattern" />
        <PropertyColumn Property="x => x.Metrics.Count">
            <MudChip T="string" Color="Color.Info" Size="Size.Small">Ranges</MudChip>
        </PropertyColumn>
        <TemplateColumn CellClass="d-flex justify-between">
            <CellTemplate>
                <MudChip T="string" Color="Color.Info" Size="Size.Small">@context.Item.Metrics?.Count Ranges</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn CellClass="d-flex justify-between">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@context.Actions.StartEditingItemAsync" />
               <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="ReportTemplateDto" PageSizeOptions="new[] { 10, 20, 50, 100 }" />
    </PagerContent>
</MudDataGrid>


<style>
    .custom-class {
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(2px);
    }   
</style>


@code {
    protected override void OnInitialized()
    {
        if(!ReportTemplateState.Value.Templates.Any())
        {
            Dispatcher.Dispatch(new LoadReportsAction());
        }
        base.OnInitialized();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateReportDialog>();
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is CreateReportTemplateRequest dto)
        {
            Dispatcher.Dispatch(new CreateTemplateAction(dto));
            Dispatcher.Dispatch(new LoadReportsAction());
        }
    }

    private async Task ManageReport(long id)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var parameters = new DialogParameters { ["ReportId"] = id };
        await DialogService.ShowAsync<EditReportDialog>("Report Configuration", parameters, options);
    }
}