@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects

<MudDialog  Class="blur dialog-background" 
            TitleClass="blur dialog-background-title" 
            ContentClass="dialog-background-surface py-2" 
            ActionsClass="dialog-background-surface">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AddChart" Class="mr-3" /> Add Report Template
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="model.Name" Label="Report Name" Required="true" />
        <MudTextField @bind-Value="model.Description" Label="Description" />
        <MudTextField @bind-Value="model.OutputDirectory" Label="Report Directory" Required="true" />
        <MudTextField @bind-Value="model.FileNamePattern" Label="Report Name Pattern (e.g. {YYYYMMDD}_MarketRisk_LimitUtilisation.xlsx)" Required="true" />
        
        <MudFileUpload T="IBrowserFile" OnFilesChanged="UploadFile" Class="mt-4"
                       Accept=".xlsx"
                       Disabled="@string.IsNullOrWhiteSpace(model.Name)">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CloudUpload">
                @(selectedFile == null ? "Upload Excel File" : selectedFile.Name)
            </MudButton>
        </MudFileUpload>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(selectedFile == null)">Create Report</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .custom-class {
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(2px);
    }

    .blur {
        backdrop-filter: blur(10px);
    }

    .dialog-background {
        background-color: transparent;
    }

    .dialog-background-title {
        background: rgba(var(--mud-palette-info-rgb), 0.5);
        color: var(--mud-palette-white);
    }

    .dialog-background-surface {
        background: rgba(var(--mud-palette-surface-rgb), 0.75);
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] HttpClient Http { get; set; } = default!;

    private readonly DialogOptions _dialogOptions = new() { FullWidth = true, BackgroundClass = "custom-class" };

    private CreateReportTemplateRequest model = new();
    private IBrowserFile? selectedFile;

    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        using var memoryStream = new MemoryStream();
        await selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
        model.FileBytes = memoryStream.ToArray();
        model.FileName = selectedFile.Name;
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(model));
    private void Cancel() => MudDialog.Cancel();
}