@page "/report-templates"
@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects
@using Smbc.Risk.ReportingEngine.WebUI.Features.ReportTemplates.Store

@inject IState<ReportTemplateState> State
@inject IDispatcher Dispatcher
@inject IDialogService DialogService

<MudTable Items="@State.Value.Templates" Loading="@State.Value.IsLoading" Hover="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Report Templates</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog">Add New</MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>ID</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Version</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="ID">@context.Id</MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Version">@context.Version</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => Delete(context.Id)" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new FetchTemplatesAction());
    }

    private void Delete(long id) => Dispatcher.Dispatch(new DeleteTemplateAction(id));

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<ReportTemplateEditDialog>("Create Template");
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is ReportTemplateDto dto)
        {
            Dispatcher.Dispatch(new CreateTemplateAction(dto));
        }
    }

    private async Task OpenEditDialog(ReportTemplateDto? template = null)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var parameters = new DialogParameters<ReportTemplateEditDialog>
    {
        { x => x.ExistingTemplate, template }
    };

        var dialog = await DialogService.ShowAsync<ReportTemplateEditDialog>(
            template == null ? "Create Template" : "Edit Template",
            parameters,
            options
        );

        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is ReportTemplateDto dto)
        {
            if (dto.Id == 0)
            {
                Dispatcher.Dispatch(new CreateTemplateAction(dto));
            }
            else
            {
                Dispatcher.Dispatch(new UpdateTemplateAction(dto));
            }
        }
    }
}