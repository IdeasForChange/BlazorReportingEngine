@using System.Text.Json
@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects
@using Smbc.Risk.ReportingEngine.Domain.Shared.Enums
@using Smbc.Risk.ReportingEngine.WebUI.Features.ReportMasters.Store
@using Smbc.Risk.ReportingEngine.WebUI.Features.ReportQueues.Store

@* @inject IReportRepository Repo *@
@inject ISnackbar Snackbar
@inject IDispatcher Dispatcher 
@inject IState<ReportMasterState> ReportMasterState

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudIconButton Icon="@Icons.Material.Outlined.Assessment" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Run / Schedule a new Report</MudText>
                <MudText Typo="Typo.caption" Color="Color.Primary">
                    Select a new report from the master list and execute.
                </MudText>
            </MudStack>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudCard Class="pa-2" Elevation="0">
            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudSelect T="long" 
                           Label="Select Job"
                           Placeholder="-- Select a Job to run --"
                           ValueChanged="OnJobSelected" 
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Required="true"
                           Clearable="true">
                    @foreach (var job in ReportMasterState.Value.Reports)
                    {
                        <MudSelectItem Value="@job.Id">@job.Name</MudSelectItem>
                    }
                </MudSelect>

                @if (_parameters.Any())
                {
                    @foreach (var param in _parameters)
                    {
                        <div class="mb-3">
                            @switch (param.ParameterType)
                            {
                                case ParameterType.String: 
                                    // String
                                    <MudTextField T="string" 
                                                  Label="@param.Name" Required="@param.IsRequired"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  ValueChanged="@(val => _paramValues[param.Name] = val)" />
                                    break;
                                case ParameterType.DateTime: 
                                    // DateTime
                                    <MudDatePicker Label="@param.Name"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Required="@param.IsRequired"
                                                   DateChanged="@(date => _paramValues[param.Name] = date?.ToString("yyyy-MM-dd") ?? "")" />
                                    break;
                                case ParameterType.Integer: 
                                    // Integer
                                    <MudNumericField T="int"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Label="@param.Name"
                                                     Required="@param.IsRequired"
                                                     ValueChanged="@(val => _paramValues[param.Name] = val.ToString())" />
                                    break;
                            }
                        </div>
                    }
                }
            </MudForm>
        </MudCard>

    </DialogContent>

    <DialogActions>
        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" Style="width: 100%;" Class="px-6 pb-4 pt-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="Cancel" Disabled="_isSubmitting" StartIcon="@Icons.Material.Filled.Cancel">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" OnClick="ResetForm" Disabled="_isSubmitting" StartIcon="@Icons.Material.Filled.LockReset">
                Reset
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="@(!_isValid)" StartIcon="@Icons.Material.Filled.DirectionsRun">
                <span>Run Report</span>
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    private List<ReportParameterDto> _parameters = new();
    private Dictionary<string, string> _paramValues = new();
    private ReportMasterDto _selectedJob;
    private EnqueueReportRequestDto _model = new();
    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        Dispatcher.Dispatch(new FetchReportMasterAction(false));
        await base.OnInitializedAsync();
        // _jobs = (await Repo.GetActiveReportMastersAsync()).ToList();
    }

    private async Task OnJobSelected(long selectedJobId)
    {
        if(selectedJobId > 0)
        {
            _selectedJob = ReportMasterState.Value.Reports?.Where(p => p.Id == selectedJobId).FirstOrDefault();
            if (_selectedJob != null)
            {
                _parameters = _selectedJob.ReportParameters.ToList();
                _paramValues = _parameters.ToDictionary(p => p.Name, p => string.Empty);
            }
        }
        else
        {
            await ResetForm();
        }
    }

    private void Cancel() => MudDialog.Cancel();
    private async Task ResetForm()
    {
        _parameters = [];
        _model = new EnqueueReportRequestDto();
        _isValid = false;
        await _form.ResetAsync();
    }

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (_isValid)
        {
            var json = JsonSerializer.Serialize(_paramValues);

            var reportRequest = new EnqueueReportRequestDto
            {
                ReportMasterId = _selectedJob.Id,
                ParameterValuesJson = json,
                CreatedBy = "CurrentUser" // Replace with actual user context
            };

            Dispatcher.Dispatch(new RunReportAction(reportRequest));
        }
    }
}