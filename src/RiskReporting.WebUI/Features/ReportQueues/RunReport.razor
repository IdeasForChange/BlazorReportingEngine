
@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects
@using Smbc.Risk.ReportingEngine.Domain.Shared.Enums
@* @inject IReportRepository Repo *@
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-4">Execute Report Master Job</MudText>

<MudCard Class="pa-4">
    <MudSelect T="long" Label="Select Report Job" ValueChanged="OnJobSelected" AnchorOrigin="Origin.BottomCenter">
        @foreach (var job in _jobs)
        {
            <MudSelectItem Value="@job.Id">@job.Name</MudSelectItem>
        }
    </MudSelect>

    @if (_parameters.Any())
    {
        <MudForm Class="mt-4">
            @foreach (var param in _parameters)
            {
                <div class="mb-3">
                    @switch (param.ParameterType)
                    {
                        case ParameterType.String: // String
                                <MudTextField T="string" Label="@param.Name" Required="@param.IsRequired"
                                              ValueChanged="@(val => _paramValues[param.Name] = val)" />
                            break;
                        case ParameterType.DateTime: // DateTime
                                <MudDatePicker Label="@param.Name"
                                               DateChanged="@(date => _paramValues[param.Name] = date?.ToString("yyyy-MM-dd") ?? "")" />
                            break;
                        case ParameterType.Integer: // Integer
                                <MudNumericField T="int" Label="@param.Name"
                                                 ValueChanged="@(val => _paramValues[param.Name] = val.ToString())" />
                            break;
                    }
                </div>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="EnqueueJob">
                Queue Job Execution
            </MudButton>
        </MudForm>
    }
</MudCard>

@code {
    private List<ReportMasterDto> _jobs = new();
    private List<ReportParameterDto> _parameters = new();
    private Dictionary<string, string> _paramValues = new();
    private long _selectedJobId;

