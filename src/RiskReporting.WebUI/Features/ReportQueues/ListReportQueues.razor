@page "/report-queues"
@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects
@using Smbc.Risk.ReportingEngine.Domain.Shared.Enums
@using Smbc.Risk.ReportingEngine.WebUI.Features.ReportQueues.Store

@inherits FluxorComponent
@inject IState<ReportQueueState> QueueState
@inject IDispatcher Dispatcher
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="d-flex justify-space-between align-center mb-0">
    <div>
        <PageHeader PageTitle="Report Queue Status"
                    PageSubTitle="View list of all JOBS Running / Completed or Failed." />
    </div>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add">
        Run a new Report
    </MudButton>

</div>


@* Styled Workspace Multi-Tabs *@
<MudPaper Elevation="2" Class="d-flex flex-column flex-grow-1 h-90 w-100 pa-0" Style="min-height: calc(100vh - 200px);">
    <MudTabs ApplyEffectsToContainer="true" Class="pa-2" Elevation="0" HeaderPosition="TabHeaderPosition.After">

        @* Main Master Grid Tab *@
        <MudTabPanel Text="All Queue Items" Icon="@Icons.Material.Outlined.Dashboard" ShowCloseIcon="false">

            <MudDataGrid T="ReportRunnerQueueDto"
                Items="@QueueState.Value.QueueItems" 
                Loading="@QueueState.Value.IsLoading" 
                Bordered="false"
                Outlined="true"
                Dense="true"
                Hover="true"
                Elevation="0">

                <ToolBarContent>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">

                        <MudText Typo="Typo.caption" Color="Color.Secondary">Filter By: </MudText>
                        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection" Variant="Variant.Text" Color="Color.Primary">
                            <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => FilterQueue("Today"))">Today</MudChip>
                            <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => FilterQueue("Yesterday"))">Yesterday</MudChip>
                            <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => FilterQueue("Week"))">Week</MudChip>
                            <MudChip Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => FilterQueue("Month"))">Month</MudChip>
                        </MudChipSet>

                    </MudStack>

                    <MudSpacer />

                    <!-- Countdown Refresh Indicator -->
                    <MudPaper Class="pa-3 mb-2" Elevation="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Auto-refreshing in <b>@_secondsRemaining</b> second(s)...
                            </MudText>
                        </MudStack>
                        <MudProgressLinear Color="Color.Primary" Value="@_progressValue" Class="rounded" />
                    </MudPaper>

                </ToolBarContent>

                <Columns>

                    <PropertyColumn Property="x => x.Id" Title="Id" />
                    <PropertyColumn Property="x => x.ReportName" Title="Report Name" />
                    <TemplateColumn Title="Status">
                         <CellTemplate>
                            <MudChip T="string" Color="GetStatusColor(context.Item.Status)" Size="Size.Small">
                                @((QueueStatus)context.Item.Status)
                            </MudChip>
                         </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Queued At">
                        <CellTemplate>
                            @context.Item.CreatedAtUtc.ToLocalTime().ToString("g")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Result">
                        <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.OutputFilePath))
                        {
                            <MudText Typo="Typo.caption">@context.Item.OutputFilePath</MudText>
                        }
                        else if (!string.IsNullOrEmpty(context.Item.ErrorMessage))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">@context.Item.ErrorMessage</MudText>
                        }
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Actions">
                        <CellTemplate>
                        @if (context.Item.Status == (int)QueueStatus.Processing || context.Item.Status == (int)QueueStatus.Pending)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Error"
                                           OnClick="() => KillJob(context.Item.Id)" Title="Kill/Cancel Job" />
                        }
                        @if (!string.IsNullOrEmpty(context.Item.OutputFilePath))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Primary"
                                           OnClick="() => OpenFile(context.Item.OutputFilePath)" Title="Download/View File" />
                            <MudIconButton Icon="@Icons.Material.Filled.Folder" Color="Color.Secondary"
                                           OnClick="() => OpenFolder(context.Item.OutputFilePath)" Title="Open Folder" />
                        }
                        </CellTemplate>
                    </TemplateColumn>

                </Columns>

                <NoRecordsContent>
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-12">
                        <MudIcon Icon="@Icons.Material.Outlined.Queue" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Color="Color.Primary">No reports</MudText>
                    </MudStack>
                </NoRecordsContent>

                <PagerContent>
                    <MudDataGridPager T="ReportRunnerQueueDto" PageSizeOptions="new[] { 10, 20, 50, 100 }" />
                </PagerContent>
            </MudDataGrid>

        </MudTabPanel>

    </MudTabs>
</MudPaper>

@code {
    private const int RefreshIntervalSeconds = 30;
    private PeriodicTimer? _timer;
    private readonly CancellationTokenSource _cts = new(); 
    
    private int _secondsRemaining = RefreshIntervalSeconds;
    private double _progressValue = 100;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Dispatcher.Dispatch(new FetchReportQueueAction("Today"));

        // Setup Auto Refresh Timer (every 1 seconds)
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunTimerAsync();
    }

    private async Task RunTimerAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                _secondsRemaining--;
                _progressValue = ((double)_secondsRemaining / RefreshIntervalSeconds) * 100;

                if (_secondsRemaining <= 0)
                {
                    // Refresh data via Fluxor Action
                    Dispatcher.Dispatch(new FetchReportQueueAction(QueueState.Value.SelectedFilter));

                    // Reset timer variables
                    _secondsRemaining = RefreshIntervalSeconds;
                    _progressValue = 100;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Graceful exit on component disposal
        }
    }

    private void FilterQueue(string filter) => Dispatcher.Dispatch(new FetchReportQueueAction(filter));

    private void KillJob(long queueId) => Dispatcher.Dispatch(new CancelQueueItemAction(queueId));

    private async Task OpenFile(string path) => await JS.InvokeVoidAsync("openLocalFile", path);

    private async Task OpenFolder(string path) => await JS.InvokeVoidAsync("openLocalFolder", Path.GetDirectoryName(path));

    private Color GetStatusColor(int status) => (QueueStatus)status switch
    {
        QueueStatus.Pending => Color.Warning,
        QueueStatus.Processing => Color.Info,
        QueueStatus.Completed => Color.Success,
        QueueStatus.Failed => Color.Error,
        QueueStatus.Cancelled => Color.Dark,
        _ => Color.Default
    };

    public async ValueTask DisposeAsync()
    {
        // 1. Cancel the background loop token
        _cts.Cancel();
        _cts.Dispose();

        // 2. Dispose the periodic timer
        _timer?.Dispose();

        await base.DisposeAsync();
        await ValueTask.CompletedTask;
    }
}