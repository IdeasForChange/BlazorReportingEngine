@page "/reports"
@using Fluxor
@using Smbc.Risk.ReportingEngine.Domain.Shared.DataTransferObjects
@using Smbc.Risk.ReportingEngine.Domain.Shared.Enums
@using Smbc.Risk.ReportingEngine.WebUI.Features.Reports.Store

@inject IState<ReportState> ReportState
@inject IDispatcher Dispatcher
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Report Generator Portal</MudText>

    <!-- Report Selection Section -->
    <MudPaper Class="pa-4 mb-6" Elevation="3">
        <MudText Typo="Typo.h6">Run New Report</MudText>

        <MudSelect T="ReportTemplateDto"
                   Label="Select Report Template"
                   Variant="Variant.Outlined"
                   ValueChanged="OnTemplateChanged"
                   Class="mt-2">
            @foreach (var template in ReportState.Value.Templates)
            {
                <MudSelectItem Value="@template">@template.Name (v@template.Version)</MudSelectItem>
            }
        </MudSelect>

        @if (_selectedTemplate != null)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.body2" Class="mb-2">@_selectedTemplate.Description</MudText>

            <MudForm @ref="_form" IsValid="@_formIsValid">
                @foreach (var param in _selectedTemplate.Parameters)
                {
                    <div class="mb-3">
                        @if (param.Type == ParameterType.Date)
                        {
                            <MudDatePicker Label="@param.Name"
                                           Required="@param.IsRequired"
                                           DateChanged="@(d => SetParamValue(param.Name, d?.ToString("yyyy-MM-dd")))" />
                        }
                        else if (param.Type == ParameterType.Number)
                        {
                            <MudNumericField T="int?" Label="@param.Name"
                                             Required="@param.IsRequired"
                                             ValueChanged="@(n => SetParamValue(param.Name, n?.ToString()))" />
                        }
                        else
                        {
                            <MudTextField T="string" Label="@param.Name"
                                          Required="@param.IsRequired"
                                          ValueChanged="@(s => SetParamValue(param.Name, s))" />
                        }
                    </div>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!_formIsValid)"
                           OnClick="EnqueueReport"
                           Class="mt-2">
                    Execute Report
                </MudButton>
            </MudForm>
        }
    </MudPaper>

    <!-- Report Runner Execution Queue -->
    <MudPaper Class="pa-4" Elevation="3">
        <MudText Typo="Typo.h6" Class="mb-2">Runner Monitor Queue</MudText>

        <MudTable Items="@ReportState.Value.QueueItems" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Job ID</MudTh>
                <MudTh>Report Name</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Progress</MudTh>
                <MudTh>Result Path / Error</MudTh>
                <MudTh>Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Id</MudTd>
                <MudTd>@context.ReportName</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudProgressLinear Color="Color.Info" Value="@context.ProgressPercentage" Class="my-2" />
                </MudTd>
                <MudTd>
                    @if (context.Status == QueueStatus.Completed)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Success">
                            @context.OutputFilePath
                        </MudText>
                    }
                    else if (context.Status == QueueStatus.Failed || context.Status == QueueStatus.Cancelled)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">
                            @context.ErrorMessage
                        </MudText>
                    }
                </MudTd>
                <MudTd>
                    @if (context.Status == QueueStatus.Processing || context.Status == QueueStatus.Pending)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => KillJob(context.Id))">
                            Kill
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private ReportTemplateDto? _selectedTemplate;
    private Dictionary<string, string> _parameterInput = new();
    private MudForm _form = default!;
    private bool _formIsValid;
    private System.Threading.Timer? _pollTimer;

    protected override void OnInitialized()
    {
        Dispatcher.Dispatch(new FetchTemplatesAction());
        Dispatcher.Dispatch(new FetchQueueAction());

        // Polling dashboard state every 2 seconds
        _pollTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() => Dispatcher.Dispatch(new FetchQueueAction()));
        }, null, 2000, 2000);
    }

    private void OnTemplateChanged(ReportTemplateDto template)
    {
        _selectedTemplate = template;
        _parameterInput.Clear();
    }

    private void SetParamValue(string key, string? value)
    {
        if (value != null) _parameterInput[key] = value;
    }

    private void EnqueueReport()
    {
        if (_selectedTemplate == null) return;
        Dispatcher.Dispatch(new EnqueueJobAction(_selectedTemplate.Id, _parameterInput));
    }

    private void KillJob(long queueId)
    {
        Dispatcher.Dispatch(new KillJobAction(queueId));
    }

    private Color GetStatusColor(QueueStatus status) => status switch
    {
        QueueStatus.Completed => Color.Success,
        QueueStatus.Processing => Color.Info,
        QueueStatus.Pending => Color.Default,
        QueueStatus.Cancelled => Color.Warning,
        QueueStatus.Failed => Color.Error,
        _ => Color.Default
    };

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}